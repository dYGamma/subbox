[Unit]
Description=subbox — PAC file server
Documentation=https://github.com/dYGamma/subbox
After=network.target

[Service]
Type=simple
Environment=PATH=@BINDIR@:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@BINDIR@/subbox serve-pac
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
